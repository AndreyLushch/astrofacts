[Unit]
Description=astrofacts
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=astrofacts
WorkingDirectory=/opt/astrofacts/current
Environment=PYTHONPATH=/opt/astrofacts/current/src
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=ASTROFACTS_HOST=127.0.0.1
Environment=ASTROFACTS_PORT=8765
Environment=ASTROFACTS_EPHE_DIR=/opt/astrofacts/ephe
ExecStart=/opt/astrofacts/current/.venv/bin/python -m astrofacts
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
# сервису не нужны ни запись на диск, ни сеть дальше localhost
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
